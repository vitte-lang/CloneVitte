    UnresolvedName,
    PrivateSymbol,
    DuplicateDeclaration,
    ShadowedDeclaration,
    UnknownType,
    NotAType,
    TypeMismatch,
    InvalidUnaryOperand,
    InvalidBinaryOperands,
    NotAssignable,
    NotCallable,
    InvalidArgumentCount,
    InvalidArgumentType,
    NotIndexable,
    InvalidIndexType,
    UnknownMember,
    ConditionNotBool,
    ReturnOutsideProc,
