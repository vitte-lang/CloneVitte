export pick SemaError {
    None,
    InvalidArgument,
    InvalidContext,
    InvalidState,
    InvalidAst,
    InvalidScope,
    InvalidType,
    TypeLimit,
    DiagnosticLimit,
    RecursionLimit,
    Overflow,
    OutOfMemory,
    Validation,
    Corruption,
    Internal,
    Count
}

export pick SemaState {
    Invalid,
    Ready,
    Analyzing,
    Done,
    Failed,
    Destroyed,
    Count
}

export pick SemaTypeKind {
    Invalid,
    Error,
    Void,
    Bool,
    I64,
    U64,
    U8,
    F32,
