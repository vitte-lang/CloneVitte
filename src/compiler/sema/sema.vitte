}

export form SemaStats {
    runs: u64,
    failed_runs: u64,
    failures: u64,
    nodes_visited: u64,
    expressions_checked: u64,
    declarations: u64,
    names_resolved: u64,
    unresolved_names: u64,
    duplicate_declarations: u64,
    shadowing_declarations: u64,
    types_created: u64,
    type_intern_hits: u64,
    calls_checked: u64,
    unreachable_statements: u64,
    diagnostics: u64,
    errors: u64,
    warnings: u64,
    max_recursion_depth: u64,
    validation_runs: u64,
    validation_failures: u64,
    hash_runs: u64,
    allocations: u64,
    reallocations: u64,
