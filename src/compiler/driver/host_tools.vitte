/// Vitte-owned orchestration for compiling generated C with the host toolchain.
/// The C boundary is limited to OS temporary-path creation and process launch.
space compiler::driver::host_tools;

use vitte::core::memory::{allocate, deallocate};

export pick DriverHostToolStage {
    None,
    Prepare,
    CCompile,
    Link,
    Execute,
    Count
}

export pick DriverHostToolStatus {
    Success,
    InvalidArgument,
    IoFailure,
    ProcessFailure,
    UnsupportedHost,
    OutOfMemory,
    Count
}

extern proc vitte_native_host_temp_path(
    kind: u32,
    buffer: *mut u8,
    capacity: usize
) -> usize;

extern proc vitte_native_host_process_run(
    program: *const u8,
    arguments: *const *const u8,
    argument_count: usize
) -> i32;
extern proc vitte_native_environment_value(name: string) -> ?str;

extern proc vitte_native_fs_file_open(path: *const u8, mode: *const u8) -> *mut u8;
extern proc vitte_native_fs_file_write(data: *const u8, length: usize, file: *mut u8) -> usize;
extern proc vitte_native_fs_file_close(file: *mut u8) -> i32;
extern proc vitte_native_fs_remove(path: *const u8) -> i32;

const HOST_TEMP_PATH_CAPACITY: usize = 4096;

proc host_tools_cleanup(
    source_buffer: *mut u8,
    executable_buffer: *mut u8,
    source_created: bool,
    executable_created: bool
) {
    if source_created { vitte_native_fs_remove(source_buffer as *const u8); }
    if executable_created { vitte_native_fs_remove(executable_buffer as *const u8); }
    if source_buffer != null { deallocate(source_buffer); }
    if executable_buffer != null { deallocate(executable_buffer); }
}

proc host_tools_write_source(
    path: *const u8,
    source: *const u8,
    source_length: usize
) -> bool {
    let file = vitte_native_fs_file_open(path, "wb".as_ptr() as *const u8);
    if file == null { return false; }
    let wrote_all = source_length == 0 or
        vitte_native_fs_file_write(source, source_length, file) == source_length;
    let close_status = vitte_native_fs_file_close(file);
    return wrote_all and close_status == 0;
}

proc host_tools_run_arguments(
    program: *const u8,
    arguments: *mut *mut u8,
    argument_count: usize
) -> i32 {
    return vitte_native_host_process_run(
        program,
        arguments as *const *const u8,
        argument_count
    );
}

/// Compile, link, and optionally execute one generated C17 translation unit.
/// Return values are DriverHostToolStatus; `failed_stage` identifies the
/// operation that produced the failure.
export proc vitte_driver_run_host_toolchain(
    source: *const u8,
    source_length: usize,
    output_path: *const u8,
    emit_object: bool,
    run_program: bool,
    debug_info: bool,
    debug_runtime: bool,
    run_argc: i32,
    run_argv: *mut *mut u8,
    failed_stage: *mut u32
) -> u32 {
    if failed_stage == null {
        return DriverHostToolStatus.InvalidArgument as u32;
    }
    set *failed_stage = DriverHostToolStage.None as u32;
    if source == null or (emit_object and run_program) or run_argc < 0 or
       (run_argc > 0 and run_argv == null) {
        set *failed_stage = DriverHostToolStage.Prepare as u32;
        return DriverHostToolStatus.InvalidArgument as u32;
    }
    if emit_object and (output_path == null or output_path[0] == 0) {
        set *failed_stage = DriverHostToolStage.Prepare as u32;
        return DriverHostToolStatus.InvalidArgument as u32;
    }

    let source_buffer = allocate(HOST_TEMP_PATH_CAPACITY);
    let mut executable_buffer: *mut u8 = null;
    if run_program {
        set executable_buffer = allocate(HOST_TEMP_PATH_CAPACITY);
    }
    if source_buffer == null or (run_program and executable_buffer == null) {
        if source_buffer != null { deallocate(source_buffer); }
        if executable_buffer != null { deallocate(executable_buffer); }
        set *failed_stage = DriverHostToolStage.Prepare as u32;
        return DriverHostToolStatus.OutOfMemory as u32;
    }

    let mut source_created = false;
    let mut executable_created = false;
    let mut compiler_program: string = "cc";
    let configured_compiler = vitte_native_environment_value("CC");
    if configured_compiler != null {
        let selected_compiler = configured_compiler?;
        if selected_compiler != "" {
            set compiler_program = selected_compiler;
        }
    }

    if vitte_native_host_temp_path(0, source_buffer, HOST_TEMP_PATH_CAPACITY) == 0 {
        host_tools_cleanup(
            source_buffer, executable_buffer,
            source_created, executable_created
        );
        set *failed_stage = DriverHostToolStage.Prepare as u32;
        return DriverHostToolStatus.IoFailure as u32;
    }
    set source_created = true;

    if run_program {
        if vitte_native_host_temp_path(2, executable_buffer, HOST_TEMP_PATH_CAPACITY) == 0 {
            host_tools_cleanup(
                source_buffer, executable_buffer,
                source_created, executable_created
            );
            set *failed_stage = DriverHostToolStage.Prepare as u32;
            return DriverHostToolStatus.IoFailure as u32;
        }
        set executable_created = true;
        // The OS primitive reserves a unique name. Remove its placeholder so
        // linkers that require a new output file can use the path.
        if vitte_native_fs_remove(executable_buffer as *const u8) != 0 {
            host_tools_cleanup(
                source_buffer, executable_buffer,
                source_created, executable_created
            );
            set *failed_stage = DriverHostToolStage.Prepare as u32;
            return DriverHostToolStatus.IoFailure as u32;
        }
    }

    if not host_tools_write_source(source_buffer as *const u8, source, source_length) {
        host_tools_cleanup(
            source_buffer, executable_buffer,
            source_created, executable_created
        );
        set *failed_stage = DriverHostToolStage.Prepare as u32;
        return DriverHostToolStatus.IoFailure as u32;
    }

    let compile_output = if run_program {
        executable_buffer as *const u8
    } else if output_path == null or output_path[0] == 0 {
        "a.out".as_ptr() as *const u8
    } else {
        output_path
    };
    let compile_arguments = allocate(12 * sizeof(*mut u8)) as *mut *mut u8;
    if compile_arguments == null {
        host_tools_cleanup(
            source_buffer, executable_buffer,
            source_created, executable_created
        );
        set *failed_stage = DriverHostToolStage.Prepare as u32;
        return DriverHostToolStatus.OutOfMemory as u32;
    }
    let mut compile_argument_count: usize = 0;
    if debug_info {
        set compile_arguments[compile_argument_count] = "-g".as_ptr() as *mut u8;
        set compile_argument_count += 1;
        set compile_arguments[compile_argument_count] = "-O0".as_ptr() as *mut u8;
        set compile_argument_count += 1;
        set compile_arguments[compile_argument_count] = "-fno-omit-frame-pointer".as_ptr() as *mut u8;
        set compile_argument_count += 1;
        set compile_arguments[compile_argument_count] = "-fno-inline".as_ptr() as *mut u8;
        set compile_argument_count += 1;
        if debug_runtime {
            set compile_arguments[compile_argument_count] = "-DVITTE_DEBUG_RUNTIME".as_ptr() as *mut u8;
            set compile_argument_count += 1;
        }
    }
    set compile_arguments[compile_argument_count] = "-std=c17".as_ptr() as *mut u8;
    set compile_argument_count += 1;
    set compile_arguments[compile_argument_count] = "-x".as_ptr() as *mut u8;
    set compile_argument_count += 1;
    set compile_arguments[compile_argument_count] = "c".as_ptr() as *mut u8;
    set compile_argument_count += 1;
    if emit_object {
        set compile_arguments[compile_argument_count] = "-c".as_ptr() as *mut u8;
        set compile_argument_count += 1;
    }
    set compile_arguments[compile_argument_count] = source_buffer;
    set compile_argument_count += 1;
    set compile_arguments[compile_argument_count] = "-o".as_ptr() as *mut u8;
    set compile_argument_count += 1;
    set compile_arguments[compile_argument_count] = compile_output as *mut u8;
    set compile_argument_count += 1;

    let compile_status = host_tools_run_arguments(
        compiler_program.as_ptr() as *const u8,
        compile_arguments,
        compile_argument_count
    );
    deallocate(compile_arguments as *mut u8);
    if compile_status != 1 {
        if emit_object { vitte_native_fs_remove(output_path); }
        host_tools_cleanup(
            source_buffer, executable_buffer,
            source_created, executable_created
        );
        set *failed_stage = DriverHostToolStage.CCompile as u32;
        return if compile_status < 0 {
            DriverHostToolStatus.OutOfMemory as u32
        } else {
            DriverHostToolStatus.ProcessFailure as u32
        };
    }

    if run_program {
        let execute_status = host_tools_run_arguments(
            executable_buffer as *const u8,
            run_argv,
            run_argc as usize
        );
        if execute_status != 1 {
            host_tools_cleanup(
                source_buffer, executable_buffer,
                source_created, executable_created
            );
            set *failed_stage = DriverHostToolStage.Execute as u32;
            return if execute_status < 0 {
                DriverHostToolStatus.OutOfMemory as u32
            } else {
                DriverHostToolStatus.ProcessFailure as u32
            };
        }
    }

    host_tools_cleanup(
        source_buffer, executable_buffer,
        source_created, executable_created
    );
    return DriverHostToolStatus.Success as u32;
}
