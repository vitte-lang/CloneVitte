[
  {
    "prefix": "proc",
    "description": "Procedure",
    "body": "proc ${1:name}(${2:value}: ${3:int}) -> ${4:void} {\n    $0\n}"
  },
  {
    "prefix": "aproc",
    "description": "Async procedure",
    "body": "async proc ${1:name}() {\n    $0\n}"
  },
