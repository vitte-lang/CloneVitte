      "    $0",
      "}"
    ],
    "description": "Loop"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "    $0",
      "}"
    ],
    "description": "For loop"
  },
  "Unsafe block": {
    "prefix": "unsafe",
    "body": [
      "unsafe {",
      "    $0",
      "}"
    ],
    "description": "Unsafe block"
  },
  "Defer": {
    "prefix": "defer",
    "body": [
      "defer {",
      "    $0",
      "}"
    ],
    "description": "Defer"
  },
  "Return value": {
    "prefix": "give",
    "body": [
      "give ${1:value};"
    ],
    "description": "Return value"
  },
  "Assertion": {
    "prefix": "assert",
    "body": [
      "assert(${1:condition});"
    ],
    "description": "Assertion"
  },
  "Entry procedure": {
    "prefix": "entry",
    "body": [
      "proc main() {",
      "    $0",
      "}"
    ],
    "description": "Entry procedure"
  },
  "Use module": {
    "prefix": "use",
    "body": [
      "use ${1:module}::{${2:item}};"
