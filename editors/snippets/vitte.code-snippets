{
  "Procedure": {
    "prefix": "proc",
    "body": [
      "proc ${1:name}(${2:value}: ${3:int}) -> ${4:void} {",
      "    $0",
      "}"
    ],
    "description": "Procedure"
  },
  "Async procedure": {
    "prefix": "aproc",
    "body": [
      "async proc ${1:name}() {",
      "    $0",
      "}"
    ],
    "description": "Async procedure"
  },
  "Unsafe procedure": {
    "prefix": "uproc",
    "body": [
      "unsafe proc ${1:name}() {",
      "    $0",
      "}"
    ],
    "description": "Unsafe procedure"
  },
  "Extern procedure": {
    "prefix": "extern",
    "body": [
      "extern \"C\" proc ${1:name}(${2:value}: ${3:int}) -> ${4:void};"
    ],
    "description": "Extern procedure"
  },
  "Constant": {
    "prefix": "const",
    "body": [
      "const ${1:NAME}: ${2:int} = ${3:0};"
    ],
    "description": "Constant"
  },
  "Static": {
    "prefix": "static",
    "body": [
      "static ${1:name}: ${2:type} = ${3:value};"
    ],
    "description": "Static"
  },
  "Local binding": {
    "prefix": "let",
    "body": [
      "let ${1:name}: ${2:type} = ${3:value};"
    ],
    "description": "Local binding"
  },
  "Mutable local binding": {
    "prefix": "letm",
    "body": [
      "let mut ${1:name}: ${2:type} = ${3:value};"
    ],
    "description": "Mutable local binding"
  },
  "Assignment": {
    "prefix": "set",
    "body": [
      "set ${1:name} = ${2:value};"
    ],
    "description": "Assignment"
  },
  "Form": {
    "prefix": "form",
    "body": [
      "form ${1:Name} {",
      "    ${2:field}: ${3:type},",
      "    $0",
      "}"
    ],
    "description": "Form"
  },
  "Pick": {
    "prefix": "pick",
    "body": [
      "pick ${1:Name} {",
      "    ${2:Ready},",
      "    ${3:Failed}(i32),",
      "    $0",
      "}"
    ],
    "description": "Pick"
  },
  "Type alias": {
    "prefix": "type",
    "body": [
      "type ${1:Name} = ${2:type};"
    ],
    "description": "Type alias"
  },
  "Opaque type": {
    "prefix": "opaque",
    "body": [
      "opaque ${1:Name};"
    ],
    "description": "Opaque type"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "    $0",
      "}"
    ],
    "description": "Trait"
  },
  "Implementation": {
    "prefix": "impl",
    "body": [
      "impl ${1:Type} {",
      "    $0",
      "}"
    ],
    "description": "Implementation"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "    ${2:pattern} => {",
      "        $0",
      "    },",
      "}"
    ],
    "description": "Match"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "If"
  },
  "If / else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "    ${2}",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "If / else"
  },
  "While loop": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "While loop"
  },
  "Loop": {
    "prefix": "loop",
    "body": [
