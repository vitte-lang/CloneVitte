    ],
    "description": "Space"
  },
  "Test": {
    "prefix": "test",
    "body": [
      "test ${1:name} {",
      "    $0",
      "}"
    ],
    "description": "Test"
  },
  "Macro": {
    "prefix": "macro",
    "body": [
      "macro ${1:name}(${2:value}: ${3:type}) {",
      "    $0",
      "}"
    ],
    "description": "Macro"
  },
  "Intrinsic": {
    "prefix": "intrinsic",
    "body": [
      "intrinsic ${1:name}(${2:value}: ${3:type}) -> ${4:void};"
    ],
    "description": "Intrinsic"
  },
  "Assembly": {
    "prefix": "asm",
    "body": [
      "asm(\"${1:instruction}\");"
    ],
    "description": "Assembly"
  }
}
