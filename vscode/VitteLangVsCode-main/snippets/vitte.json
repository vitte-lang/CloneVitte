{
  "space declaration": {
    "scope": "vit,vitte",
    "prefix": "space",
    "body": [
      "space ${1:package/module};"
    ],
    "description": "Declare the canonical Vitte module path"
  },
  "use declaration": {
    "scope": "vit,vitte",
    "prefix": "use",
    "body": [
      "use ${1:package/module}.${2:{Symbol}};"
    ],
    "description": "Import a Vitte module or symbol"
  },
  "use alias": {
    "scope": "vit,vitte",
    "prefix": "useas",
    "body": [
      "use ${1:package/module} as ${2:alias};"
    ],
    "description": "Import a Vitte module with an alias"
  },
  "export symbols": {
    "scope": "vit,vitte",
    "prefix": "export",
    "body": [
      "export { ${1:Symbol} };"
    ],
    "description": "Export an explicit symbol set"
  },
  "procedure": {
    "scope": "vit,vitte",
    "prefix": "proc",
    "body": [
      "proc ${1:name}(${2})${3: -> ${4:int}} {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a canonical Vitte procedure"
  },
  "public procedure": {
    "scope": "vit,vitte",
    "prefix": "pubproc",
    "body": [
      "pub proc ${1:name}(${2})${3: -> ${4:int}} {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a public Vitte procedure"
  },
  "async procedure": {
    "scope": "vit,vitte",
    "prefix": "asyncproc",
    "body": [
      "async proc ${1:name}(${2})${3: -> ${4:int}} {",
      "\t${0}",
      "}"
    ],
    "description": "Declare an asynchronous Vitte procedure"
  },
  "form declaration": {
    "scope": "vit,vitte",
    "prefix": "form",
    "body": [
      "form ${1:Name} {",
      "\t${2:field}: ${3:Type},",
      "\t${0}",
      "}"
    ],
    "description": "Declare a canonical Vitte form with bare typed fields"
  },
  "pick declaration": {
    "scope": "vit,vitte",
    "prefix": "pick",
    "body": [
      "pick ${1:Name} {",
      "\t${2:Variant}(${3:Type}),",
      "\t${0}",
      "}"
    ],
    "description": "Declare a canonical Vitte pick"
  },
  "trait declaration": {
    "scope": "vit,vitte",
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\tproc ${2:method}(self: ref ${1:Name}) -> ${3:Type} {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Declare a Vitte trait"
  },
  "impl declaration": {
    "scope": "vit,vitte",
    "prefix": "impl",
    "body": [
      "impl ${1:Trait} for ${2:Type} {",
      "\t${0}",
      "}"
    ],
    "description": "Implement a trait for a type"
  },
  "type alias": {
    "scope": "vit,vitte",
    "prefix": "type",
    "body": [
      "type ${1:Alias} = ${2:ExistingType};"
    ],
    "description": "Declare a Vitte type alias"
  },
  "constant": {
    "scope": "vit,vitte",
    "prefix": "const",
    "body": [
      "const ${1:NAME}: ${2:Type} = ${3:value};"
    ],
    "description": "Declare a typed constant"
  },
  "local binding": {
    "scope": "vit,vitte",
    "prefix": "let",
    "body": [
      "let ${1:name}${2: : ${3:Type}} = ${4:value};"
    ],
    "description": "Declare an initialized local binding"
  },
  "mutable local binding": {
    "scope": "vit,vitte",
    "prefix": "letmut",
    "body": [
      "let mut ${1:name}${2: : ${3:Type}} = ${4:value};"
    ],
    "description": "Declare an initialized mutable binding"
  },
  "assignment": {
    "scope": "vit,vitte",
    "prefix": "set",
    "body": [
      "set ${1:target} = ${2:value};"
    ],
    "description": "Assign through a Vitte place expression"
  },
  "give value": {
    "scope": "vit,vitte",
    "prefix": "give",
    "body": [
      "give ${1:value};"
    ],
    "description": "Return a value from a procedure"
  },
  "if expression": {
    "scope": "vit,vitte",
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "Insert an if/else expression"
  },
  "match expression": {
    "scope": "vit,vitte",
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:Pattern} => {",
      "\t\t${0}",
      "\t},",
      "}"
    ],
    "description": "Insert a canonical match expression"
  },
  "for loop": {
    "scope": "vit,vitte",
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t${0}",
      "}"
    ],
    "description": "Iterate over an expression"
  },
  "while loop": {
    "scope": "vit,vitte",
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "Insert a while loop"
  },
  "extern C block": {
    "scope": "vit,vitte",
    "prefix": "extern",
    "body": [
      "extern \"C\" proc ${1:name}(${2}) -> ${3:c_int};"
    ],
    "description": "Declare an external C procedure"
  },
  "test block": {
    "scope": "vit,vitte",
    "prefix": "test",
    "body": [
      "test \"${1:name}\" {",
      "\t${0}",
      "}"
    ],
    "description": "Declare a Vitte test"
  },
  "outer attribute": {
    "scope": "vit,vitte",
    "prefix": "attr",
    "body": [
      "#[${1:name}(${2})]"
    ],
    "description": "Insert an outer Vitte attribute"
  },
  "documentation comment": {
    "scope": "vit,vitte",
    "prefix": "doc",
    "body": [
      "/// ${1:Summary}",
      "///",
      "/// ${0:Details}"
    ],
    "description": "Insert Vitte documentation comments"
  },
  "zone comment": {
    "scope": "vit,vitte",
    "prefix": "zone",
    "body": [
      "<<<",
      "${1:comment}",
      ">>>"
    ],
    "description": "Insert a Vitte zone comment"
  },
  "procedure with contracts": {
    "scope": "vit,vitte",
    "prefix": "proccontracts",
    "body": [
      "proc ${1:name}(${2}) -> ${3:int}",
      "requires ${4:condition};",
      "ensures ${5:condition};",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "Declare a procedure with preconditions and postconditions"
  },
  "return value": {
    "scope": "vit,vitte",
    "prefix": "return",
    "body": [
      "return ${1:value};"
    ],
    "description": "Return a value from a procedure"
  },
  "entry procedure": {
    "scope": "vit,vitte",
    "prefix": "main",
    "body": [
      "proc main() -> i32 {",
      "\t${0}",
      "\treturn 0;",
      "}"
    ],
    "description": "Declare a program entry procedure"
  },
  "else if branch": {
    "scope": "vit,vitte",
    "prefix": "elif",
    "body": [
      "elif ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "Add a conditional branch"
  },
  "infinite loop": {
    "scope": "vit,vitte",
    "prefix": "loop",
    "body": [
      "loop {",
      "\t${0}",
      "}"
    ],
    "description": "Repeat until break"
  },
  "deferred block": {
    "scope": "vit,vitte",
    "prefix": "defer",
    "body": [
      "defer {",
      "\t${0}",
      "}"
    ],
    "description": "Defer a block"
  },
  "unsafe block": {
    "scope": "vit,vitte",
    "prefix": "unsafe",
    "body": [
      "unsafe {",
      "\t${0}",
      "}"
    ],
    "description": "Insert an unsafe block"
  },
  "assertion": {
    "scope": "vit,vitte",
    "prefix": "assert",
    "body": [
      "assert(${1:condition});"
    ],
    "description": "Assert a condition"
  },
  "break loop": {
    "scope": "vit,vitte",
    "prefix": "break",
    "body": [
      "break;"
    ],
    "description": "Exit the current loop"
  },
  "continue loop": {
    "scope": "vit,vitte",
    "prefix": "continue",
    "body": [
      "continue;"
    ],
    "description": "Continue the current loop"
  },
  "static binding": {
    "scope": "vit,vitte",
    "prefix": "static",
    "body": [
      "static ${1:NAME}: ${2:Type} = ${3:value};"
    ],
    "description": "Declare a static value"
  },
  "opaque type": {
    "scope": "vit,vitte",
    "prefix": "opaque",
    "body": [
      "opaque ${1:Name};"
    ],
    "description": "Declare an opaque type"
  },
  "intrinsic procedure": {
    "scope": "vit,vitte",
    "prefix": "intrinsic",
    "body": [
      "intrinsic ${1:name}(${2}) -> ${3:Type};"
    ],
    "description": "Declare an intrinsic procedure"
  }
}
