(*
  Canonical syntax target for the full Vitte language.
  The C bootstrap compiler is required to implement this grammar end-to-end.
  ::= production, | choice, [...] optional, {...} repetition.
  This grammar describes syntax, not type checking, name resolution, or recovery.
  check-ebnf-frontend-sync.py checks lexer vocabulary and C-parser token
  references, not production equivalence or successful compilation.
*)

translation_unit ::= { declaration } EOF ;

(* Declarations *)

declaration ::= { attribute | declaration_modifier }
                ( export_clause | declaration_body ) ;

declaration_modifier ::= "pub" | "export" | "async" | "unsafe" | "comptime" ;

declaration_body ::= space_declaration
                   | use_declaration
                   | value_declaration
                   | type_declaration
                   | opaque_declaration
                   | form_declaration
                   | pick_declaration
                   | trait_declaration
                   | implementation_declaration
                   | procedure_declaration
                   | external_procedure_declaration
                   | intrinsic_declaration
                   | macro_declaration
                   | test_declaration ;

attribute ::= "#" [ "!" ] "[" attribute_name { "::" attribute_name }
              [ "(" [ attribute_arguments ] ")" ] "]" ;

attribute_arguments ::= attribute_argument { "," attribute_argument } [ "," ] ;

attribute_argument ::= attribute_name [ "=" attribute_literal ]
                     | attribute_literal ;

attribute_name ::= identifier | vitte_keyword_token ;

attribute_literal ::= integer_literal | float_literal | string_literal
                    | character_literal | "true" | "false" | "null" ;

space_declaration ::= "space" module_path [ ";" | space_body ] ;

space_body ::= "{" { declaration } "}" ;

use_declaration ::= "use" module_path
                    [ "as" identifier
                    | "::" ( "*" | "{" [ import_items ] "}" )
                    ] ";" ;

import_items ::= path_alias { "," path_alias } [ "," ] ;

path_alias ::= module_path [ "as" identifier ] ;

export_clause ::= "export"
                  ( "*"
                  | path_alias
                  | "{" export_items "}"
                  ) ";" ;

export_items ::= path_alias { "," path_alias } [ "," ] ;

value_declaration ::= "const" identifier [ ":" type ]
                      "=" expression ";"
                    | "static" [ "mut" ] identifier [ ":" type ]
                      "=" expression ";" ;

type_declaration ::= "type" identifier generic_parameters [ where_clause ]
                     [ ":" type_bound { "+" type_bound } ]
                     [ "=" type ] ";" ;

opaque_declaration ::= "opaque" [ "type" ] identifier generic_parameters
                       [ where_clause ] [ "=" type ] ";" ;

form_declaration ::= "form" identifier generic_parameters [ where_clause ]
                     "{"
                       [ form_field { ( "," | ";" ) form_field }
                         [ "," | ";" ]
                       ]
                     "}" ;

form_field ::= identifier ":" type ;

pick_declaration ::= "pick" identifier generic_parameters [ where_clause ]
                     "{"
                       [ pick_variant { "," pick_variant } [ "," ] ]
                     "}" ;

pick_variant ::= identifier
                 [ "(" [ type { "," type } [ "," ] ] ")" ] ;

trait_declaration ::= "trait" identifier generic_parameters [ where_clause ]
                      declaration_block ;

implementation_declaration ::= "impl" generic_parameters type
                               [ "for" type ] [ where_clause ]
                               declaration_block ;

declaration_block ::= "{" { declaration } "}" ;

procedure_declaration ::= "proc" identifier generic_parameters
                          procedure_parameters [ "->" type ]
                          [ where_clause ] { contract_clause }
                          ( block | ";" ) ;

external_procedure_declaration ::= "extern" [ string_literal ] "proc"
                                   identifier generic_parameters
                                   procedure_parameters [ "->" type ]
                                   [ where_clause ] { contract_clause } ";" ;

intrinsic_declaration ::= "intrinsic" identifier generic_parameters
                          procedure_parameters [ "->" type ]
                          [ where_clause ] { contract_clause } ";" ;

contract_clause ::= ( "requires" | "ensures" ) expression ";" ;

macro_declaration ::= "macro" identifier [ procedure_parameters ] block ;

test_declaration ::= "test" [ identifier | string_literal ] block ;

generic_parameters ::= [ "<" [ generic_parameter
                               { "," generic_parameter } [ "," ] ] ">" ] ;

generic_parameter ::= [ "const" ] identifier
                      [ ":" type_bound { "+" type_bound } ] ;

where_clause ::= "where" where_predicate { "," where_predicate } ;

where_predicate ::= type ":" type_bound { "+" type_bound }
                  | type relational_operator expression ;

type_bound ::= type ;

relational_operator ::= "==" | "!=" | "<" | "<=" | ">" | ">=" ;

procedure_parameters ::= "(" [ procedure_parameter
                               { "," procedure_parameter } [ "," ] ] ")" ;

procedure_parameter ::= [ "mut" | "move" | "owned" | "borrow" ]
                        pattern ":" type ;

(* Types *)

type ::= procedure_type
       | reference_type
       | pointer_type
       | array_or_slice_type
       | optional_type
       | path_type ;

procedure_type ::= "proc" "(" [ procedure_type_parameters ] ")"
                   [ "->" type ] ;

procedure_type_parameters ::= procedure_type_parameter
                              { "," procedure_type_parameter } [ "," ] ;

procedure_type_parameter ::= [ identifier ":" ] type ;

reference_type ::= ( "&" | "ref" ) [ "mut" ] type ;

pointer_type ::= "*" ( "mut" | [ "const" ] [ "volatile" ] ) type ;

array_or_slice_type ::= "[" type "]"
                      | "[" type ";" expression "]"
                      | "[" expression "]" type ;

optional_type ::= "?" type ;

path_type ::= module_path [ generic_arguments ] ;

generic_arguments ::= ( "<" [ type { "," type } [ "," ] ] ">"
                      | "[" [ type { "," type } [ "," ] ] "]"
                      ) ;

module_path ::= path_segment { ( "::" | "/" ) path_segment } ;

value_path ::= path_segment { "::" path_segment } ;

path_segment ::= identifier | "compiler" | "diagnostic" ;

(* Blocks and statements. Declarations are not block statements. *)

block ::= "{" { statement } "}" ;

statement ::= let_statement
            | set_statement
            | return_statement
            | jump_statement
            | defer_statement
            | assert_statement
            | if_statement
            | while_statement
            | loop_statement
            | for_statement
            | match_statement
            | unsafe_statement
            | assembly_statement
            | block
            | expression_statement ;

let_statement ::= "let" [ "mut" ] pattern [ ":" type ]
                  [ "=" expression ] ";" ;

set_statement ::= "set" coalesce_expression assignment_operator
                  assignment_expression ";" ;

return_statement ::= "return" [ expression ] [ ";" ] ;

jump_statement ::= ( "break" | "continue" ) ";" ;

defer_statement ::= "defer" ( block | expression ";" ) ;

assert_statement ::= "assert" "(" expression ")" ";" ;

if_statement ::= ( "if" | "elif" ) expression block
                 { "elif" expression block }
                 [ "else" ( if_statement | block ) ] ;

while_statement ::= "while" expression block ;

loop_statement ::= "loop" block ;

for_statement ::= "for" pattern "in" expression block ;

match_statement ::= "match" expression "{"
                    [ match_arm { "," match_arm } [ "," ] ]
                    "}" ;

match_arm ::= [ "case" ] pattern [ "if" expression ]
              "=>" match_arm_body ;

match_arm_body ::= block | statement | expression [ ";" ] ;

unsafe_statement ::= "unsafe" block ;

assembly_statement ::= "asm"
                       ( "(" [ expression_list ] ")"
                       | string_literal
                       ) ";" ;

expression_statement ::= expression [ ";" ] ;

(* Patterns *)

pattern ::= pattern_atom { "|" pattern_atom } ;

pattern_atom ::= ( "mut" | "ref" ) pattern_atom
               | "(" [ pattern_list ] ")"
               | "[" [ pattern_list ] "]"
               | "else"
               | range_pattern
               | literal_pattern
               | generic_variant_pattern
               | path_pattern ;

pattern_list ::= pattern { "," pattern } [ "," ] ;

range_pattern ::= pattern_literal ( ".." | "..=" )
                  ( integer_literal | float_literal | character_literal ) ;

literal_pattern ::= pattern_literal ;

pattern_literal ::= integer_literal | float_literal | string_literal
                  | character_literal | "true" | "false" | "null" ;

generic_variant_pattern ::= path_type "::" identifier
                            [ "(" [ pattern_list ] ")" ] ;

path_pattern ::= pattern_path
                 [ "(" [ pattern_list ] ")"
                 | "{" [ struct_pattern_items ] "}"
                 ] ;

pattern_path ::= ( value_path | "self" ) { "." identifier } ;

struct_pattern_items ::= struct_pattern_item
                         { "," struct_pattern_item } [ "," ] ;

struct_pattern_item ::= identifier [ ":" pattern ] | ".." ;

(* Expressions *)

expression ::= assignment_expression ;

assignment_expression ::= coalesce_expression
                          [ assignment_operator assignment_expression ] ;

assignment_operator ::= "=" | "+=" | "-=" | "*=" | "/=" | "%="
                      | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

coalesce_expression ::= logical_or_expression
                        [ "??" coalesce_expression ] ;

logical_or_expression ::= logical_and_expression
                          { ( "or" | "||" ) logical_and_expression } ;

logical_and_expression ::= bitwise_or_expression
                           { ( "and" | "&&" ) bitwise_or_expression } ;

bitwise_or_expression ::= bitwise_xor_expression
                          { "|" bitwise_xor_expression } ;

bitwise_xor_expression ::= bitwise_and_expression
                           { "^" bitwise_and_expression } ;

bitwise_and_expression ::= equality_expression
                           { "&" equality_expression } ;

equality_expression ::= comparison_expression
                        { ( "==" | "!=" ) comparison_expression } ;

comparison_expression ::= shift_expression
                          { ( "<" | "<=" | ">" | ">=" ) shift_expression } ;

shift_expression ::= additive_expression
                     { ( "<<" | ">>" ) additive_expression } ;

additive_expression ::= multiplicative_expression
                        { ( "+" | "-" ) multiplicative_expression } ;

multiplicative_expression ::= range_expression
                              { ( "*" | "/" | "%" ) range_expression } ;

range_expression ::= unary_expression
                     { ( ".." | "..=" ) unary_expression } ;

unary_expression ::= ( "&" | "ref" ) "mut" unary_expression
                   | unary_operator unary_expression
                   | cast_expression ;

unary_operator ::= "+" | "-" | "~" | "*" | "&" | "not" | "move" | "ref"
                 | "await" ;

cast_expression ::= postfix_expression { "as" type } ;

postfix_expression ::= primary_expression
                       { ordinary_postfix_suffix }
                       [ generic_form_or_variant_suffix ]
                       { ordinary_postfix_suffix }
                     | value_path form_initializer
                       { ordinary_postfix_suffix } ;

ordinary_postfix_suffix ::= "(" [ expression_list ] ")"
                          | "[" expression "]"
                          | "." identifier
                          | "?" ;

generic_form_or_variant_suffix ::= generic_arguments
                                   ( form_initializer
                                   | "::" identifier
                                   ) ;

primary_expression ::= literal
                     | value_path
                     | "self"
                     | "print"
                     | "null" "(" [ expression_list ] ")"
                     | sizeof_expression
                     | alignof_expression
                     | if_expression
                     | array_expression
                     | "(" expression ")"
                     | block_expression ;

sizeof_expression ::= "sizeof" "(" ( type | expression ) ")" ;

alignof_expression ::= "alignof" "(" type ")" ;

if_expression ::= ( "if" | "elif" ) expression block_expression
                  if_expression_tail ;

if_expression_tail ::= "elif" expression block_expression if_expression_tail
                     | "else" ( if_expression | block_expression ) ;

block_expression ::= "{"
                     { block_expression_statement }
                     [ expression ]
                     "}" ;

block_expression_statement ::= let_statement
                             | set_statement
                             | return_statement
                             | jump_statement
                             | defer_statement
                             | assert_statement
                             | if_statement_without_else
                             | while_statement
                             | loop_statement
                             | for_statement
                             | expression ";" ;

if_statement_without_else ::= "if" expression block ;

array_expression ::= "[" [ expression_list ] "]" ;

form_initializer ::= "{" [ form_initializer_field
                            { "," form_initializer_field } [ "," ] ] "}" ;

form_initializer_field ::= identifier ":" expression ;

expression_list ::= expression { "," expression } [ "," ] ;

literal ::= integer_literal | float_literal | string_literal
          | character_literal | "true" | "false" | "null" ;

(* Lexical forms *)

EOF ::= end of source ;

CR ::= U+000D ;

LF ::= U+000A ;

valid_utf8_scalar ::= Unicode scalar value encoded as valid UTF-8 ;

identifier ::= identifier_start { identifier_continue } ;

identifier_start ::= "A"..."Z" | "a"..."z" | "_"
                   | non_ascii_identifier_start ;

identifier_continue ::= identifier_start | "0"..."9"
                      | non_ascii_identifier_continue ;

vitte_keyword_token ::= "space" | "use" | "pub" | "const" | "static"
                      | "type" | "opaque" | "form" | "pick" | "trait"
                      | "impl" | "where" | "proc" | "extern" | "intrinsic"
                      | "macro" | "comptime" | "test" | "let" | "mut"
                      | "set" | "return" | "defer" | "requires" | "ensures"
                      | "export" | "if" | "else" | "elif" | "while"
                      | "loop" | "for" | "in" | "break" | "continue"
                      | "match" | "as" | "async" | "await" | "unsafe"
                      | "asm" | "move" | "ref" | "self" | "and" | "or"
                      | "not" | "true" | "false" | "null" | "assert"
                      | "sizeof" | "alignof" | "print" | "share" | "region"
                      | "compiler" | "diagnostic" | "bench" | "entry"
                      | "select" | "when" | "case" | "critical" | "owned"
                      | "borrow" | "is" | "kernel" | "class" | "flags" ;

(* `give` is emitted only by an older C lexer; it is not native syntax. *)
legacy_lexer_keyword ::= "give" ;

(* The native lexer emits these operators, but the parser assigns them no syntax. *)
lexer_only_operator ::= "@" | "$" ;

integer_literal ::= digit_sequence
                  | ( "0b" | "0B" ) binary_digit_sequence
                  | ( "0o" | "0O" ) octal_digit_sequence
                  | ( "0x" | "0X" ) hexadecimal_digit_sequence ;

float_literal ::= decimal_float | hexadecimal_float ;

decimal_float ::= digit_sequence "." [ digit_sequence ] [ decimal_exponent ]
                | digit_sequence decimal_exponent ;

decimal_exponent ::= ( "e" | "E" ) [ "+" | "-" ] digit_sequence ;

hexadecimal_float ::= ( "0x" | "0X" ) hexadecimal_digit_sequence
                      [ "." [ hexadecimal_digit_sequence ] ]
                      ( "p" | "P" ) [ "+" | "-" ] digit_sequence ;

digit_sequence ::= digit { [ "_" ] digit } ;

binary_digit_sequence ::= binary_digit { [ "_" ] binary_digit } ;

octal_digit_sequence ::= octal_digit { [ "_" ] octal_digit } ;

hexadecimal_digit_sequence ::= hexadecimal_digit
                               { [ "_" ] hexadecimal_digit } ;

string_literal ::= '"' { string_character | escape_sequence } '"' ;

character_literal ::= "'" ( character | escape_sequence ) "'" ;

escape_sequence ::= BACKSLASH
                    ( BACKSLASH | "'" | '"' | "0" | "a" | "b"
                    | "f" | "n" | "r" | "t" | "v"
                    | "x" hexadecimal_digit hexadecimal_digit
                    | "u" hexadecimal_digit hexadecimal_digit
                           hexadecimal_digit hexadecimal_digit
                    | "U" hexadecimal_digit hexadecimal_digit
                           hexadecimal_digit hexadecimal_digit
                           hexadecimal_digit hexadecimal_digit
                           hexadecimal_digit hexadecimal_digit
                    ) ;

string_character ::= valid_utf8_scalar except '"', BACKSLASH, CR, or LF ;

character ::= valid_utf8_scalar except "'", BACKSLASH, CR, or LF ;

BACKSLASH ::= U+005C ;

digit ::= "0"..."9" ;

binary_digit ::= "0" | "1" ;

octal_digit ::= "0"..."7" ;

hexadecimal_digit ::= digit | "a"..."f" | "A"..."F" ;

non_ascii_identifier_start ::= codepoint accepted by
                               vitte_unicode_is_identifier_start ;

non_ascii_identifier_continue ::= codepoint accepted by
                                  vitte_unicode_is_identifier_continue ;

(* Trivia is ASCII space, tab, LF, CR, form feed, or vertical tab.
   Line comments start with // and end before LF. Block comments /* ... */
   nest and must be balanced. Identifiers use the compiler's explicit Unicode
   predicates, not the full Unicode XID properties. Numeric digit separators
   are single underscores between digits. Hexadecimal floats require p/P.
   The `[expression] type` array form requires an integer literal as its first
   token; the parser uses that token to distinguish it from a slice type.
   Match arms may omit a comma only when the following arm starts with `case`
   or the `else` wildcard.
   `return expr` may omit its semicolon only immediately before `}` or EOF. *)
