/// Formes nommées pour les regroupements de valeurs à arité fixe.
space core::types::tuple;

/// Paire de valeurs potentiellement distinctes.
export form Pair<T, U> {
    first: T,
    second: U,
}

/// Triplet de valeurs potentiellement distinctes.
export form Triple<T, U, V> {
    first: T,
    second: U,
    third: V,
}

/// Groupe de quatre valeurs potentiellement distinctes.
export form Quad<T, U, V, W> {
    first: T,
    second: U,
    third: V,
    fourth: W,
}
