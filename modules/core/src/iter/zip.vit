/// Copie deux tranches dans des tampons parallèles fournis par l'appelant.
space core::iter::zip;

export proc zip_copy<T, U>(
    left: &[T],
    right: &[U],
    left_output: &mut [T],
    right_output: &mut [U]
) -> usize {
    let mut count: usize = left.len();
    if right.len() < count { set count = right.len(); }
    if left_output.len() < count { set count = left_output.len(); }
    if right_output.len() < count { set count = right_output.len(); }
    for index in 0..count {
        set left_output[index] = left[index];
        set right_output[index] = right[index];
    }
    return count;
}
