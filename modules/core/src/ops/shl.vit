/// Décalages binaires vers la gauche, définis sur la largeur de la valeur.
///
/// Un décalage hors largeur retourne zéro. Les formes vérifiées écrivent dans
/// un paramètre de sortie et retournent `false` sans le modifier si la quantité
/// dépasse la largeur; elles ne signalent pas une perte de bits.
space core::ops::shl;

export proc shl_i8(left: i8, amount: usize) -> i8 {
    if amount >= 8 { return 0; }
    return ((left as u64) << amount) as i8;
}

export proc shl_i16(left: i16, amount: usize) -> i16 {
    if amount >= 16 { return 0; }
    return ((left as u64) << amount) as i16;
}

export proc shl_i32(left: i32, amount: usize) -> i32 {
    if amount >= 32 { return 0; }
    return ((left as u64) << amount) as i32;
}

export proc shl_i64(left: i64, amount: usize) -> i64 {
    if amount >= 64 { return 0; }
    return ((left as u64) << amount) as i64;
}

export proc shl_u8(left: u8, amount: usize) -> u8 {
    if amount >= 8 { return 0; }
    return ((left as u64) << amount) as u8;
}

export proc shl_u16(left: u16, amount: usize) -> u16 {
    if amount >= 16 { return 0; }
    return ((left as u64) << amount) as u16;
}

export proc shl_u32(left: u32, amount: usize) -> u32 {
    if amount >= 32 { return 0; }
    return ((left as u64) << amount) as u32;
}

export proc shl_u64(left: u64, amount: usize) -> u64 {
    if amount >= 64 { return 0; }
    return left << amount;
}

export proc checked_shl_i8(left: i8, amount: usize, output: &mut i8) -> bool {
    if amount >= 8 { return false; }
    set *output = shl_i8(left, amount);
    return true;
}

export proc checked_shl_i16(left: i16, amount: usize, output: &mut i16) -> bool {
    if amount >= 16 { return false; }
    set *output = shl_i16(left, amount);
    return true;
}

export proc checked_shl_i32(left: i32, amount: usize, output: &mut i32) -> bool {
    if amount >= 32 { return false; }
    set *output = shl_i32(left, amount);
    return true;
}

export proc checked_shl_i64(left: i64, amount: usize, output: &mut i64) -> bool {
    if amount >= 64 { return false; }
    set *output = shl_i64(left, amount);
    return true;
}

export proc checked_shl_u8(left: u8, amount: usize, output: &mut u8) -> bool {
    if amount >= 8 { return false; }
    set *output = shl_u8(left, amount);
    return true;
}

export proc checked_shl_u16(left: u16, amount: usize, output: &mut u16) -> bool {
    if amount >= 16 { return false; }
    set *output = shl_u16(left, amount);
    return true;
}

export proc checked_shl_u32(left: u32, amount: usize, output: &mut u32) -> bool {
    if amount >= 32 { return false; }
    set *output = shl_u32(left, amount);
    return true;
}

export proc checked_shl_u64(left: u64, amount: usize, output: &mut u64) -> bool {
    if amount >= 64 { return false; }
    set *output = shl_u64(left, amount);
    return true;
}
