/// Algorithmes sûrs pour les tableaux empruntés sous forme de tranches.
///
/// Les fonctions acceptent une tranche afin de fonctionner aussi bien sur un
/// tableau inline que sur une vue empruntée. Les opérations entre deux
/// tranches s'arrêtent à la longueur disponible la plus courte, sauf pour
/// l'égalité qui exige des longueurs identiques.
space core::array::fixed;

export proc fixed_fill<T>(array: &mut [T], value: T) {
    for index in 0 as usize..(array.len() as usize) {
        set array[index] = value;
    }
}

export proc fixed_copy<T>(source: &[T], destination: &mut [T]) -> usize {
    let mut length: usize = (source.len() as usize);
    if (destination.len() as usize) < length {
        set length = (destination.len() as usize);
    }

    for index in 0 as usize..length {
        set destination[index] = source[index];
    }

    return length;
}

export proc fixed_equal<T>(left: &[T], right: &[T]) -> bool {
    if (left.len() as usize) != (right.len() as usize) { return false; }

    for index in 0 as usize..(left.len() as usize) {
        if left[index] != right[index] { return false; }
    }

    return true;
}

export proc fixed_contains<T>(array: &[T], value: T) -> bool {
    for index in 0 as usize..(array.len() as usize) {
        if array[index] == value { return true; }
    }

    return false;
}

export proc fixed_index_of<T>(array: &[T], value: T) -> isize {
    for index in 0 as usize..(array.len() as usize) {
        if array[index] == value { return index as isize; }
    }

    return -1;
}

export proc fixed_reverse<T>(array: &mut [T]) {
    let mut index: usize = 0;
    while index < (array.len() as usize) / 2 {
        let opposite: usize = (array.len() as usize) - 1 - index;
        let temporary: T = array[index];
        set array[index] = array[opposite];
        set array[opposite] = temporary;
        set index = index + 1;
    }
}

export proc fixed_rotate_left<T>(array: &mut [T]) {
    if (array.len() as usize) < 2 { return; }
    let first: T = array[0];
    let mut index: usize = 0;
    while index + 1 < (array.len() as usize) {
        set array[index] = array[index + 1];
        set index = index + 1;
    }
    set array[(array.len() as usize) - 1] = first;
}

export proc fixed_rotate_right<T>(array: &mut [T]) {
    if (array.len() as usize) < 2 { return; }
    let last: T = array[(array.len() as usize) - 1];
    let mut index: usize = (array.len() as usize) - 1;
    while index > 0 {
        set array[index] = array[index - 1];
        set index = index - 1;
    }
    set array[0] = last;
}

export proc fixed_count<T>(array: &[T], value: T) -> usize {
    let mut count: usize = 0;
    for index in 0 as usize..(array.len() as usize) {
        if array[index] == value { set count = count + 1; }
    }
    return count;
}

export proc fixed_is_sorted_i64(array: &[i64]) -> bool {
    if (array.len() as usize) < 2 { return true; }
    for index in 1 as usize..(array.len() as usize) {
        let previous: usize = index - 1;
        if array[index] < array[previous] { return false; }
    }
    return true;
}

export proc fixed_is_sorted_u64(array: &[u64]) -> bool {
    if (array.len() as usize) < 2 { return true; }
    for index in 1 as usize..(array.len() as usize) {
        let previous: usize = index - 1;
        if array[index] < array[previous] { return false; }
    }
    return true;
}

export proc fixed_is_sorted_f64(array: &[f64]) -> bool {
    if (array.len() as usize) < 2 { return true; }
    for index in 1 as usize..(array.len() as usize) {
        let previous: usize = index - 1;
        if array[index] < array[previous] { return false; }
    }
    return true;
}
