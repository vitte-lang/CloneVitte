space core::array::init;

use core::num::checked::{CheckedI64Result, checked_i64_add, checked_i64_sub, checked_i64_mul};

/// Initialise tous les éléments avec une valeur donnée.
export proc array_init_fill<T>(
    array: &mut [T],
    value: T
) {
    for i in 0..array.len() {
        set array[i] = value;
    }
}

/// Initialise les éléments avec leur valeur par défaut.
proc array_init_default<T>(
    array: &mut [T]
) {
    for i in 0..array.len() {
        set array[i] = T::default();
    }
}

/// Initialise tous les éléments à zéro.
proc array_init_zero<T>(
    array: &mut [T]
) {
    for i in 0..array.len() {
        set array[i] = T::zero();
    }
}

/// Initialise les éléments à partir d'une fonction génératrice.
proc array_init_with<T>(
    array: &mut [T],
    generator: proc(usize) -> T
) {
    for i in 0..array.len() {
        set array[i] = generator(i);
    }
}

/// Initialise les éléments à partir de leur indice.
export proc array_init_indexed(
    array: &mut [usize]
) {
    for i in 0..array.len() {
        set array[i] = i;
    }
}

/// Initialise un tableau avec une séquence croissante.
export proc array_init_sequence(
    array: &mut [i64],
    start: i64,
    step: i64
) -> bool {
    let mut probe: i64 = start;

    // Valider toute la séquence avant écriture évite un résultat partiel.
    for i in 0..array.len() {
        if i + 1 < array.len() {
            let next: CheckedI64Result = checked_i64_add(probe, step);
            if not next.success { return false; }
            set probe = next.value;
        }
    }

    let mut current: i64 = start;

    for i in 0..array.len() {
        set array[i] = current;
        if i + 1 < array.len() {
            set current = current + step;
        }
    }

    return true;
}

/// Initialise un tableau avec une séquence décroissante.
export proc array_init_reverse_sequence(
    array: &mut [i64],
    start: i64,
    step: i64
) -> bool {
    let mut probe: i64 = start;

    for i in 0..array.len() {
        if i + 1 < array.len() {
            let next: CheckedI64Result = checked_i64_sub(probe, step);
            if not next.success { return false; }
            set probe = next.value;
        }
    }

    let mut current: i64 = start;

    for i in 0..array.len() {
        set array[i] = current;
        if i + 1 < array.len() {
            set current = current - step;
        }
    }

    return true;
}

/// Copie les éléments d'un tableau source.
/// Retourne le nombre d'éléments copiés.
export proc array_init_copy<T>(
    source: &[T],
    destination: &mut [T]
) -> usize {
    let mut count: usize = destination.len() as usize;

    if (source.len() as usize) < count {
        set count = source.len() as usize;
    }

    for i in 0 as usize..count {
        set destination[i as usize] = source[i as usize];
    }

    return count;
}

/// Initialise uniquement les éléments satisfaisant une condition.
proc array_init_if<T>(
    array: &mut [T],
    predicate: proc(usize) -> bool,
    value: T
) {
    for i in 0..array.len() {
        if predicate(i) {
            set array[i] = value;
        }
    }
}

/// Initialise les éléments d'une plage [start, end).
export proc array_init_range<T>(
    array: &mut [T],
    start: usize,
    end: usize,
    value: T
) {
    let mut begin = start;
    let mut limit = end;

    if begin > array.len() {
        set begin = array.len();
    }

    if limit > array.len() {
        set limit = array.len();
    }

    let mut index: usize = begin;
    while index < limit {
        set array[index] = value;
        set index = index + 1;
    }
}

/// Initialise les éléments d'un tableau avec une alternance de valeurs.
export proc array_init_alternating<T>(
    array: &mut [T],
    first: T,
    second: T
) {
    for i in 0..array.len() {
        if i % 2 == 0 {
            set array[i] = first;
        } else {
            set array[i] = second;
        }
    }
}

/// Initialise les éléments selon une progression géométrique.
export proc array_init_geometric(
    array: &mut [i64],
    start: i64,
    ratio: i64
) -> bool {
    let mut probe: i64 = start;

    for i in 0..array.len() {
        if i + 1 < array.len() {
            let next: CheckedI64Result = checked_i64_mul(probe, ratio);
            if not next.success { return false; }
            set probe = next.value;
        }
    }

    let mut current: i64 = start;

    for i in 0..array.len() {
        set array[i] = current;
        if i + 1 < array.len() {
            set current = current * ratio;
        }
    }

    return true;
}

/// Initialise tous les éléments avec la même valeur booléenne.
export proc array_init_bool(
    array: &mut [bool],
    value: bool
) {
    for i in 0..array.len() {
        set array[i] = value;
    }
}

/// Initialise un tableau de booléens à false.
export proc array_init_false(
    array: &mut [bool]
) {
    for i in 0..array.len() {
        set array[i] = false;
    }
}

/// Initialise un tableau de booléens à true.
export proc array_init_true(
    array: &mut [bool]
) {
    for i in 0..array.len() {
        set array[i] = true;
    }
}
