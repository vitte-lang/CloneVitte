space core::array::repeat;

use core::num::checked::{CheckedI64Result, checked_i64_add, checked_i64_mul};
use core::num::limits::{I64_MAX};

/// Remplit un tableau avec une valeur répétée.
export proc array_repeat_fill<T>(
    array: &mut [T],
    value: T
) {
    for i in 0..array.len() {
        set array[i] = value;
    }
}

/// Remplit les premières positions avec une valeur répétée.
/// Retourne le nombre d'éléments écrits.
export proc array_repeat_n<T>(
    array: &mut [T],
    value: T,
    count: usize
) -> usize {
    let mut limit: usize = count;

    if limit > array.len() {
        set limit = array.len();
    }

    for i in 0..limit {
        set array[i] = value;
    }

    return limit;
}

/// Répète une valeur dans une plage [start, end).
export proc array_repeat_range<T>(
    array: &mut [T],
    start: usize,
    end: usize,
    value: T
) -> usize {
    let mut begin: usize = start;
    let mut limit: usize = end;

    if begin > array.len() {
        set begin = array.len();
    }

    if limit > array.len() {
        set limit = array.len();
    }

    if begin >= limit {
        return 0;
    }

    let mut index: usize = begin;
    while index < limit {
        set array[index] = value;
        set index = index + 1;
    }

    return limit - begin;
}

/// Répète un motif jusqu'à remplir la destination.
export proc array_repeat_pattern<T>(
    destination: &mut [T],
    pattern: &[T]
) -> usize {
    if pattern.len() == 0 {
        return 0;
    }

    for i in 0..destination.len() {
        let index: usize = i % pattern.len();
        set destination[i] = pattern[index];
    }

    return destination.len();
}

/// Répète un motif un nombre déterminé de fois.
/// Le résultat est limité à la capacité de destination.
export proc array_repeat_pattern_n<T>(
    destination: &mut [T],
    pattern: &[T],
    repetitions: usize
) -> usize {
    if pattern.len() == 0 {
        return 0;
    }

    let mut written: usize = 0;

    for repetition in 0..repetitions {
        for i in 0..pattern.len() {
            if written >= destination.len() {
                return written;
            }

            set destination[written] = pattern[i];
            set written = written + 1;
        }
    }

    return written;
}

/// Répète deux valeurs en alternance.
export proc array_repeat_alternating<T>(
    array: &mut [T],
    first: T,
    second: T
) {
    for i in 0..array.len() {
        if i % 2 == 0 {
            set array[i] = first;
        } else {
            set array[i] = second;
        }
    }
}

/// Répète trois valeurs selon un cycle.
export proc array_repeat_three<T>(
    array: &mut [T],
    first: T,
    second: T,
    third: T
) {
    for i in 0..array.len() {
        let position: usize = i % 3;

        if position == 0 {
            set array[i] = first;
        } elif position == 1 {
            set array[i] = second;
        } else {
            set array[i] = third;
        }
    }
}

/// Répète une valeur uniquement aux indices multiples d'un pas.
export proc array_repeat_step<T>(
    array: &mut [T],
    value: T,
    step: usize
) -> usize {
    if step == 0 {
        return 0;
    }

    let mut written: usize = 0;

    for i in 0..array.len() {
        if i % step == 0 {
            set array[i] = value;
            set written = written + 1;
        }
    }

    return written;
}

/// Répète une valeur sur des blocs de taille fixe.
/// Chaque bloc écrit est suivi d'un bloc ignoré.
export proc array_repeat_blocks<T>(
    array: &mut [T],
    value: T,
    block_size: usize
) -> usize {
    if block_size == 0 {
        return 0;
    }

    let mut written: usize = 0;
    let mut position: usize = 0;
    let mut fill: bool = true;

    while position < array.len() {
        let mut count: usize = 0;

        while count < block_size && position < array.len() {
            if fill {
                set array[position] = value;
                set written = written + 1;
            }

            set position = position + 1;
            set count = count + 1;
        }

        set fill = not fill;
    }

    return written;
}

/// Répète une valeur tant qu'un prédicat l'autorise.
proc array_repeat_while<T>(
    array: &mut [T],
    value: T,
    predicate: proc(usize) -> bool
) -> usize {
    let mut written: usize = 0;

    for i in 0..array.len() {
        if not predicate(i) {
            return written;
        }

        set array[i] = value;
        set written = written + 1;
    }

    return written;
}

/// Génère des valeurs à partir d'une fonction.
/// La fonction reçoit l'indice de destination.
proc array_repeat_generate<T>(
    array: &mut [T],
    generator: proc(usize) -> T
) {
    for i in 0..array.len() {
        set array[i] = generator(i);
    }
}

/// Répète une valeur calculée à partir de l'indice
/// dans un cycle de longueur déterminée.
proc array_repeat_cycle<T>(
    array: &mut [T],
    cycle_length: usize,
    generator: proc(usize) -> T
) -> usize {
    if cycle_length == 0 {
        return 0;
    }

    for i in 0..array.len() {
        let cycle_index: usize = i % cycle_length;
        set array[i] = generator(cycle_index);
    }

    return array.len();
}

/// Répète une séquence de valeurs numériques.
export proc array_repeat_sequence(
    array: &mut [i64],
    start: i64,
    step: i64,
    cycle_length: usize
) -> bool {
    if cycle_length == 0 {
        return false;
    }

    // Vérifier toutes les valeurs avant toute écriture.
    for i in 0..array.len() {
        let position: usize = i % cycle_length;
        if position > I64_MAX as usize { return false; }
        let product: CheckedI64Result = checked_i64_mul(position as i64, step);
        if not product.success { return false; }
        let value: CheckedI64Result = checked_i64_add(start, product.value);
        if not value.success { return false; }
    }

    for i in 0..array.len() {
        let position: i64 = (i % cycle_length) as i64;
        let product: CheckedI64Result = checked_i64_mul(position, step);
        let value: CheckedI64Result = checked_i64_add(start, product.value);
        set array[i] = value.value;
    }

    return true;
}

/// Répète chaque élément source plusieurs fois.
export proc array_repeat_each<T>(
    source: &[T],
    destination: &mut [T],
    repetitions: usize
) -> usize {
    let mut written: usize = 0;

    for i in 0..source.len() {
        for repetition in 0..repetitions {
            if written >= destination.len() {
                return written;
            }

            set destination[written] = source[i];
            set written = written + 1;
        }
    }

    return written;
}

/// Répète un motif en ordre inverse.
export proc array_repeat_reverse_pattern<T>(
    destination: &mut [T],
    pattern: &[T]
) -> usize {
    if pattern.len() == 0 {
        return 0;
    }

    for i in 0..destination.len() {
        let position: usize = i % pattern.len();
        let index: usize = pattern.len() - 1 - position;

        set destination[i] = pattern[index];
    }

    return destination.len();
}

/// Répète un motif en alternant sens normal et inverse.
export proc array_repeat_ping_pong<T>(
    destination: &mut [T],
    pattern: &[T]
) -> usize {
    if pattern.len() == 0 {
        return 0;
    }

    if pattern.len() == 1 {
        for i in 0..destination.len() {
            set destination[i] = pattern[0];
        }
        return destination.len();
    }

    let pattern_length: usize = pattern.len() as usize;
    let mut source_index: usize = 0;
    let mut forward: bool = true;
    let mut destination_index: usize = 0;

    while destination_index < destination.len() {
        set destination[destination_index] = pattern[source_index];
        set destination_index = destination_index + 1;

        if forward {
            if source_index + 1 >= pattern_length {
                set forward = false;
                set source_index = source_index - 1;
            } else {
                set source_index = source_index + 1;
            }
        } else if source_index == 0 {
            set forward = true;
            set source_index = 1;
        } else {
            set source_index = source_index - 1;
        }
    }

    return destination.len();
}

/// Remplit un tableau et retourne sa longueur.
export proc array_repeat_fill_count<T>(
    array: &mut [T],
    value: T
) -> usize {
    for i in 0..array.len() {
        set array[i] = value;
    }

    return array.len();
}

/// Répète un motif uniquement sur une plage.
export proc array_repeat_pattern_range<T>(
    destination: &mut [T],
    pattern: &[T],
    start: usize,
    end: usize
) -> usize {
    if pattern.len() == 0 {
        return 0;
    }

    let mut begin: usize = start;
    let mut limit: usize = end;

    if begin > destination.len() {
        set begin = destination.len();
    }

    if limit > destination.len() {
        set limit = destination.len();
    }

    if begin >= limit {
        return 0;
    }

    let mut index: usize = begin;
    while index < limit {
        let pattern_index: usize = (index - begin) % pattern.len();
        set destination[index] = pattern[pattern_index];
        set index = index + 1;
    }

    return limit - begin;
}
