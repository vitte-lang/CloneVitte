use core::primitive::bool::{bool_is_true, bool_is_false, bool_xor, bool_to_u8};
use core::primitive::char::{char_is_ascii_digit, char_to_ascii_lowercase, char_to_ascii_uppercase};
use core::primitive::float::{f64_abs, f64_is_finite, f64_is_zero};
use core::primitive::integer::{i64_is_even, i64_is_odd, u64_is_power_of_two};
use core::primitive::signed::{i64_signum, i64_unsigned_abs};
use core::primitive::unit::{Unit, unit_value};
use core::num::limits::{I64_MAX};

test "primitive helpers cover booleans characters numbers and floats" {
    assert(bool_is_true(true));
    assert(bool_is_false(false));
    assert(bool_xor(true, false));
    assert(bool_to_u8(true) == 1);
    assert(char_is_ascii_digit('7'));
    assert(char_to_ascii_lowercase('A') == 'a');
    assert(char_to_ascii_uppercase('z') == 'Z');
    assert(f64_abs(-1.5) == 1.5);
    assert(f64_is_finite(1.5));
    assert(f64_is_zero(0.0));
    assert(i64_is_even(-4));
    assert(i64_is_odd(3));
    assert(u64_is_power_of_two(1024));
    assert(i64_signum(-5) == -1);
    assert(i64_unsigned_abs(-9223372036854775807 - 1) == I64_MAX as u64 + 1 as u64);
    let unit: Unit = unit_value();
}
