use core::array::init::{
    array_init_fill,
    array_init_indexed,
    array_init_sequence,
    array_init_reverse_sequence,
    array_init_copy,
    array_init_range,
    array_init_alternating,
    array_init_geometric,
    array_init_bool,
    array_init_false,
    array_init_true,
};
use core::num::limits::{I64_MIN, I64_MAX};

proc initialize_i64_range(array: &mut [i64], start: usize, end: usize, value: i64) {
    array_init_range(array, start, end, value);
}

test "array initialization covers values ranges and bounded copies" {
    let mut values: [i64] = [0, 0, 0, 0];
    array_init_fill(&mut values, 9);
    assert(values[0] == 9 && values[3] == 9);

    assert(array_init_sequence(&mut values, -2, 3));
    assert(values[0] == -2 && values[1] == 1 && values[2] == 4 && values[3] == 7);

    assert(array_init_reverse_sequence(&mut values, 10, 3));
    assert(values[0] == 10 && values[1] == 7 && values[2] == 4 && values[3] == 1);

    array_init_range(&mut values, 1, 3, 42);
    assert(values[0] == 10 && values[1] == 42 && values[2] == 42 && values[3] == 1);
    initialize_i64_range(&mut values, 3, 1, -1);
    assert(values[1] == 42 && values[2] == 42);
    initialize_i64_range(&mut values, 99, 101, -1);
    assert(values[3] == 1);

    let source: [i64] = [4, 5, 6];
    let mut destination: [i64] = [0, 0];
    assert(array_init_copy(&source, &mut destination) == 2);
    assert(destination[0] == 4 && destination[1] == 5);
}

test "array initialization handles indices patterns and booleans" {
    let mut indices: [usize] = [9 as usize, 9 as usize, 9 as usize];
    array_init_indexed(&mut indices);
    assert(indices[0] == 0 && indices[1] == 1 && indices[2] == 2);

    let mut values: [i64] = [0, 0, 0, 0, 0];
    array_init_alternating(&mut values, 3, 8);
    assert(values[0] == 3 && values[1] == 8 && values[4] == 3);
    assert(array_init_geometric(&mut values, 2, 3));
    assert(values[0] == 2 && values[1] == 6 && values[2] == 18 && values[4] == 162);

    let mut bools: [bool] = [false, false, false];
    array_init_true(&mut bools);
    assert(bools[0] && bools[2]);
    array_init_false(&mut bools);
    assert(not bools[0] && not bools[2]);
    array_init_bool(&mut bools, true);
    assert(bools[0] && bools[1] && bools[2]);
}

test "checked numeric initializers leave output unchanged on overflow" {
    let mut values: [i64] = [11, 22, 33];
    assert(not array_init_sequence(&mut values, I64_MAX, 1));
    assert(values[0] == 11 && values[1] == 22 && values[2] == 33);

    assert(not array_init_reverse_sequence(&mut values, I64_MIN, 1));
    assert(values[0] == 11 && values[1] == 22 && values[2] == 33);

    assert(not array_init_geometric(&mut values, I64_MAX, 2));
    assert(values[0] == 11 && values[1] == 22 && values[2] == 33);

    let mut empty: [i64] = [];
    assert(array_init_sequence(&mut empty, I64_MAX, 1));
}
