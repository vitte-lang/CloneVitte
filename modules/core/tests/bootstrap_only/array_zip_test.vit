use core::array::zip::{
    array_zip_min_length,
    array_zip3_min_length,
    array_zip4_min_length,
    array_zip,
    array_zip3,
    array_zip4,
};

test "array zip combines up to the shortest input and output" {
    let left: [i64] = [10, 20, 30];
    let right: [u8] = [1 as u8, 2 as u8];
    let mut left_output: [i64] = [0];
    let mut right_output: [u8] = [0 as u8, 0 as u8];

    assert(array_zip_min_length(&left, &right) == 2);
    assert(array_zip(&left, &right, &mut left_output, &mut right_output) == 1);
    assert(left_output[0] == 10 && right_output[0] == 1 as u8);

    let third: [bool] = [true, false, true, false];
    let fourth: [i32] = [4, 5, 6];
    let mut first_output: [i64] = [0, 0];
    let mut second_output: [u8] = [0 as u8, 0 as u8];
    let mut third_output: [bool] = [false, false];
    assert(array_zip3_min_length(&left, &right, &third) == 2);
    assert(array_zip3(&left, &right, &third, &mut first_output, &mut second_output, &mut third_output) == 2);
    assert(first_output[1] == 20 && second_output[1] == 2 as u8 && not third_output[1]);

    let mut fourth_output: [i32] = [0, 0];
    assert(array_zip4_min_length(&left, &right, &third, &fourth) == 2);
    assert(array_zip4(&left, &right, &third, &fourth, &mut first_output, &mut second_output, &mut third_output, &mut fourth_output) == 2);
    assert(first_output[0] == 10 && second_output[0] == 1 as u8 && third_output[0] && fourth_output[0] == 4);
    assert(first_output[1] == 20 && second_output[1] == 2 as u8 && not third_output[1] && fourth_output[1] == 5);
}
